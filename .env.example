# Supabase (Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Paystack public key (client-side)
VITE_PAYSTACK_KEY=pk_live_xxx

# R2 credentials are NOT in this file — Supabase Edge Function secrets: supabase/R2-PHASE-1.md

# --- R2 uploads without browser→R2 CORS ---
# Netlify: deploy with netlify.toml; set server env in Netlify UI (SUPABASE_URL, R2_*). Then:
# VITE_R2_UPLOAD_PROXY_URL=https://mirasperfume.com/api/r2-upload
# (netlify.toml rewrites /api/r2-upload → the r2-upload function.)
# Vercel: use api/r2-upload.js and the same client URL if you deploy there instead.
# Use the exact hostname you use in the browser (apex vs www).

# Optional emergency only (NOT for production if you moved off Supabase Storage on purpose):
# VITE_PRODUCT_IMAGES_DRIVER=supabase
# VITE_R2_FALLBACK_SUPABASE=1
